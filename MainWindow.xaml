<Window x:Class="TaskbarBatteryWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskbarBatteryWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Şimdi Yenile" Click="RefreshMenuItem_Click" />
            <MenuItem x:Name="LockPositionMenuItem" Header="Konumu Sabitle" IsCheckable="True" IsChecked="True" Click="LockPositionMenuItem_Click" />
            <MenuItem Header="Konumu Sıfırla (Sol Alt)" Click="ResetPositionMenuItem_Click" />
            <Separator />
            <MenuItem x:Name="AutoStartMenuItem" Header="Windows ile Başlat" IsCheckable="True" Click="AutoStartMenuItem_Click" />
            <Separator />
            <MenuItem Header="Çıkış" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border x:Name="MainBorder"
            Background="#01000000"
            Padding="6,2"
            Margin="0">

        <ItemsControl x:Name="DevicesItemsControl">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#18FFFFFF"
                            BorderBrush="#22FFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="3,0"
                            ToolTip="{Binding TooltipText}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Device SVG Icon -->
                            <Path Data="{Binding IconGeometry}"
                                  Fill="{Binding AccentBrush}"
                                  Width="15"
                                  Height="15"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />

                            <!-- Mini Battery Bar -->
                            <Grid Width="6" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="{Binding BarVisibility}">
                                <Border Background="#33FFFFFF" CornerRadius="2" />
                                <Border Background="{Binding AccentBrush}"
                                        CornerRadius="2"
                                        VerticalAlignment="Bottom"
                                        Height="{Binding BarFillHeight}" />
                            </Grid>

                            <!-- Percentage Text -->
                            <TextBlock Text="{Binding DisplayText}"
                                       Foreground="{Binding TextBrush}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
